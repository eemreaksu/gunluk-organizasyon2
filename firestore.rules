rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'user'
      );
    }

    // User profiles: Users can read all (for lists), but only Admins or self can write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Daily Organization data: 
    // Admins have full access.
    // Staff can read and update shifts, but NOT sensitive global stats or targets
    match /dailyData/{dateId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isStaff() && (
        // Admins can change anything
        isAdmin() || 
        // Staff can update but cannot change sensitive fields
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rekor', 'hedefCiro', 'gerceklesenCiro', 'manualTargets', 'manualAdet'
        ]))
      );
      allow delete: if isAdmin();
    }

    // Captain Schedules: Staff (Admin/User) can read/write their organization
    match /captainSchedules/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Productivity: Only Admins can set targets. Everyone else can only read.
    match /productivity/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Departments: Auth users can read, only Admins can write
    match /departments/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
